adModelChunk(DOCS_modelChunk); DOCS_modelChunk = undefined;</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunk = {"chunk":[{"ty":"is","ibi":12165,"s":"Một quận đông dân thường xuyên gặp tình trạng “tất cả xe cấp cứu đều bận”. Mô hình nào phù hợp nhất để bố trí xe?\n\n  Phủ dự phòng hoặc phủ kỳ vọng (tính xác suất xe bận) \n  Phủ tập hợp cơ bản \n  p-phân tán \n  Mô hình Weber \n \nCorrect answer\nQuestion 14\n1 / 1 pts\nBốn phường nằm liền nhau theo hàng P–Q–R–S với số học sinh 8, 10, 7, 5 (nghìn). Cần chia thành 2 khu tuyển sinh liền kề. Độ lệch nhỏ nhất giữa hai khu là bao nhiêu?\n\n  6 \n  0 \n  14 \n  20 \n \nCorrect answer\nQuestion 15\n1 / 1 pts\nĐối thủ đã mở cửa hàng tại B trên mạng A–G (khách đi về cửa hàng gần nhất, bằng nhau thì chia đôi). Bạn chỉ mở 1 cửa hàng. Đặt tại E thì thu được 365 khách; đặt ngay tại B thì sao?\n\n  435 khách — tốt hơn E \n  200 khách \n  870 khách \n  0 khách vì đối thủ đã chiếm B \nQuiz Score: 15 out of 15\n\nTuần 6:\nQuestion 1\n1 / 1 pts\nMột quán cà phê có trung bình 40 khách đến mỗi giờ, mỗi khách ở lại trong quán trung bình 12 phút. Theo định luật Little, số khách trung bình có mặt trong quán là bao nhiêu?\n  3,33 khách \n  4,8 khách \n  480 khách \n  8 khách \n \nCorrect answer\nQuestion 2\n1 / 1 pts\nTại một chi nhánh ngân hàng, khách đến với tốc độ λ \u003d 24 khách/giờ và trung bình luôn có Lq \u003d 6 khách đang đứng chờ. Thời gian chờ trung bình Wq của mỗi khách là:\n  15 phút \n  0,25 phút \n  4 phút \n  144 phút \n \nCorrect answer\nQuestion 3\n1 / 1 pts\nMột quầy dịch vụ có λ \u003d 12 khách/giờ, thời gian chờ trung bình Wq \u003d 6 phút, thời gian phục vụ trung bình 1/μ \u003d 4 phút. Số khách trung bình trong toàn hệ thống L là:\n  0,8 khách \n  2 khách \n  120 khách \n  1,2 khách \n \nCorrect answer\nQuestion 4\n1 / 1 pts\nMột nhà thuốc có 1 dược sĩ (mô hình M/M/1), khách đến 18 người/giờ, thời gian phục vụ trung bình 3 phút/khách. Xác suất một khách vừa đến phải chờ là:\n  0,54 \n  0,60 \n  0,90 \n  0,10 \n \nCorrect answer\nQuestion 5\n1 / 1 pts\nHệ thống M/M/1 có λ \u003d 8 khách/giờ, μ \u003d 10 khách/giờ. Số khách trung bình trong hệ thống L là:\n  5 \n  0,8 \n  3,2 \n  4 \n \nCorrect answer\nQuestion 6\n1 / 1 pts\nVới cùng hệ thống ở câu 5 (λ \u003d 8, μ \u003d 10 khách/giờ), thời gian chờ trung bình trong hàng Wq (trước khi được phục vụ) là:\n  30 phút \n  20 phút \n  24 phút \n  6 phút \n \nCorrect answer\nQuestion 7\n1 / 1 pts\nMột hệ G/G/1 có hệ số sử dụng ρ \u003d 0,75, thời gian phục vụ trung bình 4 phút, hệ số biến thiên bình phương của thời gian giữa hai lần đến cₐ² \u003d 1 và của thời gian phục vụ cₛ² \u003d 0,25. Theo công thức xấp xỉ, Wq ≈ ?\n  15 phút \n  3 phút \n  7,5 phút \n  12 phút \n \nCorrect answer\nQuestion 8\n1 / 1 pts\nTrong mô hình M/M/1, nếu hệ số sử dụng tăng từ ρ \u003d 0,8 lên ρ \u003d 0,95 thì số khách trung bình trong hệ thống L tăng lên khoảng bao nhiêu lần?\n  1,19 lần \n  15 lần \n  2 lần \n  4,75 lần \n \nCorrect answer\nQuestion 9\n1 / 1 pts\nMột trạm thu phí 1 làn (M/M/1) có λ \u003d 50 xe/giờ, μ \u003d 60 xe/giờ. Thời gian một xe ở trong hệ thống tuân theo phân phối mũ với trung bình W \u003d 1/(μ − λ). Xác suất một xe phải ở lại trạm hơn 12 phút là khoảng:\n  20% \n  13,5% \n  1,8% \n  36,8% \n \nCorrect answer\nQuestion 10\n1 / 1 pts\nMột quầy check-in có 130 hành khách đến mỗi giờ, mỗi nhân viên phục vụ trung bình 3 phút/khách, dùng chung 1 hàng (M/M/s). Số nhân viên tối thiểu để hệ thống ổn định (không bị ùn tắc vô hạn) là:\n  6 \n  5 \n  8 \n  7 \n \nCorrect answer\nQuestion 11\n1 / 1 pts\nMột website bán hàng (mô hình M/G/∞) có 900 lượt truy cập mỗi giờ, mỗi lượt ở lại trung bình 4 phút. Số người trung bình đang online cùng lúc là:\n  3.600 \n  225 \n  15 \n  60 \n \nCorrect answer\nQuestion 12\n1 / 1 pts\nMột bãi đỗ xe có xe đến theo quá trình Poisson với 600 xe/giờ, mỗi xe ở đúng 2 giờ. Số xe trong bãi ~ Poisson(1.200) ≈ Chuẩn(1.200; √1.200 ≈ 34,6). Để bãi KHÔNG đầy với xác suất 98% (z ≈ 2,054), cần khoảng bao nhiêu chỗ?\n  1.340 chỗ \n  1.271 chỗ \n  1.235 chỗ \n  1.200 chỗ \n \nCorrect answer\nQuestion 13\n1 / 1 pts\nMột bãi đỗ nhỏ có 3 chỗ, không có chỗ chờ (xe đến khi đầy thì bỏ đi). Xe đến 2 xe/giờ, mỗi xe đỗ trung bình 1 giờ. Theo công thức Erlang B, tỉ lệ xe bị từ chối là khoảng:\n  66,7% \n  33,3% \n  21,1% \n  13,3% \n \nCorrect answer\nQuestion 14\n1 / 1 pts\nMột máy rửa xe tự động có thời gian rửa cố định 4 phút/xe (M/D/1), xe đến 12 xe/giờ. Thời gian chờ trung bình Wq theo công thức Pollaczek–Khinchine (σ \u003d 0) là:\n"},{"ty":"as","st":"paragraph","si":12278,"ei":12278,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_ifl_i":true,"ps_bb_i":true,"ps_pbb_i":true}},{"ty":"as","st":"paragraph","si":12279,"ei":12279,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_ifl_i":true,"ps_bb_i":true,"ps_pbb_i":true}},{"ty":"as","st":"paragraph","si":12335,"ei":12335,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_ifl_i":true,"ps_bb_i":true,"ps_pbb_i":true}},{"ty":"as","st":"paragraph","si":12357,"ei":12357,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_