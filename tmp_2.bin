defined , undefined , undefined , undefined , false , 0 , 0 , 0 ); DOCS_warmStartDocumentLoader = KX_kixApp.getWarmStartDocumentLoader(); DOCS_cseBlobArtifactsHolder = KX_kixApp.getCseBlobArtifactsHolder(); DOCS_initialLoadTiming = KX_kixApp.getInitialLoadTiming(); KX_getLatencyStats = function() {return KX_kixApp.getPerformanceManager().getInitialLoadStats();}; KX_resize = function() {KX_kixApp.resize();}; _docs_annotate_getAnnotatedText = function(id) {return KX_kixApp.getAnnotatedText(id);};}DOCS_timing['sac'] = new Date().getTime(); KX_startKix(); DOCS_initialLoadTiming.setTime('eac');</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_warmStartDocumentLoader.startLoad( 123.0 ,'v1qLcTS_b-NxnQ', 2.147483647E9 , 0.0 ,[2147483647,"AAE\u003d"], null , null ); var DOCS_modelChunkLoadStart; var DOCS_modelChunkParseStart; var DOCS_modelChunk;</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunk = {"chunk":[{"ty":"is","ibi":1,"s":"Tuần 1:\nQuestion 1\n1 / 1 pts\nDịch vụ thường được định nghĩa là gì?\n\n  Một hành động mang lại lợi ích (act of beneficial activity) \n  Một sản phẩm vật lý có thể lưu trữ \n  Một quy trình sản xuất hàng loạt \n  Một hình thức đầu tư tài chính \n \nCorrect answer\nQuestion 2\n1 / 1 pts\nBa nhóm nguồn lực truyền thống được huy động trong quá trình biến đổi (transformation) để tạo ra dịch vụ là gì?\n\n  Tự nhiên, Con người, Nhân tạo/Hạ tầng \n  Vốn, Lao động, Công nghệ thông tin \n  Đất đai, Tiền tệ, Thương hiệu \n  Khách hàng, Đối thủ cạnh tranh, Nhà cung cấp \n \nCorrect answer\nQuestion 3\n1 / 1 pts\n\"Điểm chạm dịch vụ\" (Service Encounter) còn được gọi là gì trong bài giảng?\n\n  \"Moment of Truth\" (khoảnh khắc quyết định) \n  \"Point of Sale\" (điểm bán hàng) \n  \"Value Chain\" (chuỗi giá trị) \n  \"Service Recovery\" (phục hồi dịch vụ) \n \nCorrect answer\nQuestion 4\n1 / 1 pts\nTrong ví dụ dịch vụ ăn uống, ai là \"nhà cung cấp\" (provider)?\n\n  Nhà hàng \n  Khách hàng \n  Món ăn \n  Hoá đơn \n \nCorrect answer\nQuestion 5\n1 / 1 pts\nYếu tố nào sau đây KHÔNG thể thiếu khi thực hiện bất kỳ dịch vụ nào, vì mọi tương tác giữa nhà cung cấp và khách hàng đều cần nó?\n\n  Thời gian \n  Màu sắc \n  Kích thước \n  Trọng lượng \n \nCorrect answer\nQuestion 6\n1 / 1 pts\n Trong 4 giai đoạn của vòng đời dịch vụ, giai đoạn nào là nơi phần lớn điểm chạm dịch vụ diễn ra?\n\n  Thực hiện (Perform) \n  Phát triển (Develop) \n  Tìm hiểu (Learn) \n  Cải tiến (Improve) \n \nCorrect answer\nQuestion 7\n1 / 1 pts\n Nếu một khách hàng không hài lòng ở một điểm chạm nhưng sau đó được làm hài lòng trở lại ở điểm chạm tiếp theo, khái niệm nào mô tả điều này?\n\n  Phục hồi dịch vụ \n  Toàn cầu hóa \n  Chuỗi giá trị \n  Marketing Mix \nQuiz Score: 7 out of 7\nTuần 2:\nCorrect answer\nQuestion 1\n1 / 1 pts\nPhát biểu nào mô tả đúng nhất bản chất của SOA?\n\n  Một triết lý thiết kế, chia chức năng thành các dịch vụ độc lập giao tiếp qua giao diện rõ ràng \n  Một giao thức truyền thông dựa trên XML \n  Một nền tảng đóng gói ứng dụng bằng container \n  Một loại cơ sở dữ liệu phân tán \n \nCorrect answer\nQuestion 2\n1 / 1 pts\n Dịch vụ Thanh toán đổi từ Momo sang VNPay ở bên trong, còn dịch vụ Giỏ hàng vẫn gọi cùng một API như cũ mà không cần sửa gì. Đây là minh họa cho nguyên lý nào?\n\n  Loose Coupling (Kết nối lỏng lẻo) \n  Reusability (Tái sử dụng) \n  Statelessness (Không trạng thái) \n  Monolith \n \nCorrect answer\nQuestion 3\n1 / 1 pts\n Một ngân hàng dùng chung một dịch vụ Xác thực người dùng cho app di động, website và hệ thống nội bộ nhân viên. Lợi ích chính của nguyên lý được áp dụng ở đây là gì?\n\n  Giảm chi phí phát triển và đảm bảo quy tắc bảo mật nhất quán giữa các ứng dụng \n  Tăng tốc độ truyền dữ liệu qua mạng \n  Cho phép mỗi ứng dụng có cơ sở dữ liệu riêng \n  Loại bỏ nhu cầu dùng mã xác thực (token) \n \nCorrect answer\nQuestion 4\n1 / 1 pts\nKhi gọi API \u0027Tính phí vận chuyển\u0027, bạn không cần biết dịch vụ dùng thuật toán định tuyến nào hay chạy trên máy chủ ở đâu. Điều này thể hiện nguyên lý nào?\n\n  Abstraction (Trừu tượng hóa) \n  Reusability \n  Statelessness \n  Service Discovery \n \nCorrect answer\nQuestion 5\n1 / 1 pts\nVì sao nguyên lý Không trạng thái (Statelessness) giúp hệ thống dễ mở rộng?\n\n  Vì mỗi yêu cầu chứa đủ thông tin cần thiết, nên bất kỳ máy chủ nào cũng xử lý được mà không cần đồng bộ trạng thái \n  Vì dịch vụ lưu toàn bộ phiên đăng nhập của người dùng trong bộ nhớ \n  Vì các dịch vụ dùng chung một cơ sở dữ liệu \n  Vì chỉ có một máy chủ duy nhất xử lý mọi yêu cầu \n \nCorrect answer\nQuestion 6\n1 / 1 pts\nTrong bộ ba Web Services truyền thống, WSDL có vai trò gì?\n\n  Tài liệu XML mô tả \u0027hợp đồng\u0027 của dịch vụ: có những hàm nào, nhận/trả về dữ liệu gì \n  Giao thức nhắn tin dựa trên XML \n  \u0027Danh bạ\u0027 để đăng ký và tìm kiếm dịch vụ \n  Lớp hạ tầng quản lý giao tiếp giữa các dịch vụ \n \nCorrect answer\nQuestion 7\n1 / 1 pts\nĐặc điểm nào sau đây thuộc về REST chứ KHÔNG phải SOAP?\n\n  Dùng các phương thức HTTP có sẵn (GET/POST/PUT/DELETE) và thường trao đổi JSON \n  Bắt buộc dùng định dạng XML \n  Có nhiều chuẩn phụ WS-* như WS-Security \n  Thường dùng trong hệ thống ngân hàng lõi để đảm bảo chuẩn hóa nghiêm ngặt \n"},{"ty":"as","st":"document","si":0,"ei":0,"sm":{"ds_pw":595.4399999999999,"ds_lhs":1,"ds_ulhfl":false,"ds_ph":841.68}},{"ty":"as","st":"headings","si":0,"ei":0,"sm":{"hs_h3":{"sdef_ps":{"ps_sb_i":false,"ps_sb":16.0},"sdef_ts":{"ts_bd_i":false,"ts_fgc2_i":false,"ts_fgc2":{"hclr_color":"#434343","clr_type":0},"ts_bd":false}},"hs_t":{"sdef_ps":{"ps_sb_i":false,"ps_sa_i":false,"ps_sa":3.0,"ps_sb":0.0},"sdef_ts":{"ts_bd_i":true,"ts_fs":26.0,"ts_bd":false,"ts_fs_i":false}},"hs_h2":{"sdef_ps":{"ps_sa_i":false,"ps_sa":6.0},"sdef_ts":{"ts_bd_i":false,"ts_fs":16.0,"ts_bd":false,"ts_fs_i":false}},"hs_h1":{"sdef_ps":{"ps_sb_i":false,"ps_sb":20.0},"sdef_ts":{"ts_bd_i":true,"ts_fs":20.0,"ts_bd":false,"ts_f