i":false,"ts_bd_i":true,"ts_bd":true,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":2970,"ei":3137,"sm":{"ts_bd_i":true,"ts_bd":true}},{"ty":"as","st":"text","si":3138,"ei":3255,"sm":{"ts_bgc2_i":false,"ts_bd_i":true,"ts_bd":true,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":3256,"ei":3522,"sm":{"ts_bd_i":true,"ts_bd":true}},{"ty":"as","st":"text","si":3523,"ei":3609,"sm":{"ts_bgc2_i":false,"ts_bd_i":true,"ts_bd":true,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":3610,"ei":3833,"sm":{"ts_bd_i":true,"ts_bd":true}},{"ty":"as","st":"text","si":3834,"ei":3915,"sm":{"ts_bgc2_i":false,"ts_bd_i":true,"ts_bd":true,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":3916,"ei":4066,"sm":{"ts_bd_i":true,"ts_bd":true}}],"revision":123}; DOCS_modelChunkLoadStart = new Date().getTime(); DOCS_initialLoadTiming.incrementTime('mp', DOCS_modelChunkLoadStart - DOCS_modelChunkParseStart); DOCS_warmStartDocumentLoader.loadModelChunk(DOCS_modelChunk); DOCS_modelChunk = undefined;</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunk = {"chunk":[{"ty":"is","ibi":4067,"s":" \nCorrect answer\nQuestion 8\n1 / 1 pts\nĐiểm khác biệt nào giữa Microservices và SOA truyền thống là ĐÚNG?\n\n  Mỗi microservice thường có cơ sở dữ liệu riêng và được triển khai độc lập (vd: bằng Docker) \n  Microservices chia sẻ một cơ sở dữ liệu chung, SOA truyền thống thì mỗi dịch vụ có CSDL riêng \n  Microservices bắt buộc dùng ESB làm hạ tầng chung \n  SOA truyền thống có dịch vụ nhỏ hơn microservices \n \nCorrect answer\nQuestion 9\n1 / 1 pts\nTrong hệ thống microservices, API Gateway đóng vai trò gì?\n\n  Cổng vào duy nhất tiếp nhận yêu cầu từ client rồi định tuyến đến đúng dịch vụ nội bộ \n  Lưu trữ dữ liệu dùng chung cho mọi dịch vụ \n  Đóng gói dịch vụ thành container \n  Mô tả hợp đồng dịch vụ bằng XML \n \nCorrect answer\nQuestion 10\n1 / 1 pts\nMột hệ thống có hàng chục dịch vụ, các instance liên tục được tạo mới và tắt đi. Thành phần nào giúp các dịch vụ tự động biết dịch vụ khác đang chạy ở đâu?\n\n  Service Registry \u0026 Discovery \n  API Gateway \n  WSDL \n  Monolith \nQuiz Score: 10 out of 10\nTuần 3\nQuestion 1\n1 / 1 pts\nTheo tài liệu bài giảng, 5 yếu tố then chốt để xây dựng mọi mô hình tối ưu hóa\nlần lượt là gì?\n\n  Dữ liệu đầu vào, Biến quyết định, Hàm mục tiêu, Ràng buộc, Phân tích độ nhạy \n  Biến số, Phương trình, Đồ thị, Thuật toán, Kết quả \n  Chi phí, Doanh thu, Lợi nhuận, Ngân sách, Nhân sự \n  Tập hợp, Chỉ số, Hằng số, Hàm số, Nghiệm nguyên \n \nCorrect answer\nQuestion 2\n1 / 1 pts\nLỗi phổ biến nhất khi xây dựng mô hình tối ưu hóa được đề cập trong slide là gì?\n\n  Nhầm lẫn giữa Dữ liệu đầu vào (Biết trước) và Biến quyết định (Mô hình tìm ra) \n  Sử dụng quá nhiều biến quyết định số nguyên \n  Chọn hàm mục tiêu là phi tuyến thay vì tuyến tính \n  Không đưa điều kiện ràng buộc ngân sách vào mô hình \n \nCorrect answer\nQuestion 3\n1 / 1 pts\nTrong bài toán Quy hoạch tuyến tính (LP) chuẩn, nghiệm tối ưu luôn nằm ở đâu trên đồ thị miền khả thi?\n\n  Tại một đỉnh của miền khả thi \n  Tại trọng tâm của miền khả thi \n  Tại điểm chính giữa của ràng buộc chặt nhất \n  Nằm ngẫu nhiên bên trong miền khả thi \n \nCorrect answer\nQuestion 4\n1 / 1 pts\nKhi thêm một điều kiện ràng buộc mới vào bài toán tối ưu hóa tuyến tính, giá trị hàm mục tiêu (nghiệm tối ưu) sẽ thay đổi như thế nào?\n\n  Chỉ có thể tệ đi hoặc giữ nguyên (không bao giờ tốt hơn) \n  Luôn luôn tốt hơn trước \n  Chắc chắn không thay đổi \n  Tăng gấp đôi giá trị ban đầu \n \nCorrect answer\nQuestion 5\n1 / 1 pts\nKhái niệm \u0027Giá bóng\u0027 (Shadow price) của một tài nguyên đại diện cho điều gì?\n\n  Lượng mục tiêu tăng thêm tương ứng khi bổ sung thêm 1 đơn vị tài nguyên đó \n  Giá trị giảm bớt của hàm mục tiêu khi bỏ bớt tài nguyên \n  Chi phí cố định để mua tài nguyên trên thị trường \n  Chi phí cơ hội khi tài nguyên bị lãng phí \n \nCorrect answer\nQuestion 6\n1 / 1 pts\nTheo nguyên lý Bù lỏng (Complementary slackness), giá bóng của một tài nguyên còn dư (chưa dùng hết) bằng bao nhiêu?\n\n  Bằng 0 \n  Bằng 1 \n  Bằng tổng ngân sách \n  Bằng vô cùng \n \nCorrect answer\nQuestion 7\n1 / 1 pts\nVì sao bài toán mạng (Network problems) lại rất được ưa chuộng trong thực tế?\n\n  Trực quan dễ vẽ, thuật toán giải siêu nhanh và tự động ra nghiệm nguyên \n  Không bao giờ cần dữ liệu đầu vào \n  Luôn cho nghiệm là số thực có dấu phẩy động \n  Chỉ giải được các bài toán nhỏ dưới 5 biến \n \nCorrect answer\nQuestion 8\n1 / 1 pts\nTrong bài toán quy hoạch nguyên, phương pháp đơn giản là \u0027làm tròn\u0027 nghiệm số thực từ LP có nguy cơ gây ra hậu quả gì?\n\n  Có thể làm vi phạm các điều kiện ràng buộc (nghiệm không khả thi) hoặc vượt ngân sách \n  Làm cho mô hình chạy chậm hơn 100 lần \n  Luôn luôn thu được nghiệm tối ưu chính xác \n  Tự động chuyển bài toán tuyến tính thành phi tuyến \n \nCorrect answer\nQuestion 9\n1 / 1 pts\nThuật toán chính xác phổ biến nhất được dùng để giải bài toán quy hoạch nguyên (IP) bằng cách chia nhỏ bài toán và loại bỏ nhánh vô ích là:\n\n  Thuật toán Nhánh và Cận (Branch and Bound) \n  Thuật toán Di truyền (Genetic Algorithm) \n  Phương pháp 2-opt \n  Thuật toán Láng giềng gần nhất (Nearest Neighbor) \n \nCorrect answer\nQuestion 10\n1 / 1 pts\nTrong bài toán tối ưu nhiều mục tiêu, một lựa chọn A được gọi là \u0027Trội\u0027 (Dominate) lựa chọn B khi nào\n"},{"ty":"as","st":"paragraph","si":4068,"ei":4068,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_ifl_i":true,"ps_bb_i":true,"ps_pbb_i":true}},{"ty":"as","st":"paragraph","si":4083,"ei":4083,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":tru