se,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":6906,"ei":6915,"sm":{"ts_bgc2_i":false,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":7082,"ei":7156,"sm":{"ts_bgc2_i":false,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":7445,"ei":7533,"sm":{"ts_bgc2_i":false,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}},{"ty":"as","st":"text","si":7854,"ei":7899,"sm":{"ts_bgc2_i":false,"ts_bgc2":{"hclr_color":"#00ff00","clr_type":0}}}],"revision":123}; DOCS_modelChunkLoadStart = new Date().getTime(); DOCS_initialLoadTiming.incrementTime('mp', DOCS_modelChunkLoadStart - DOCS_modelChunkParseStart); DOCS_warmStartDocumentLoader.loadModelChunk(DOCS_modelChunk); DOCS_modelChunk = undefined;</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="fKP5q3htS_3l1NB7v5zrPA">DOCS_modelChunk = {"chunk":[{"ty":"is","ibi":8159,"s":"\n  A không tệ hơn B ở mọi mục tiêu VÀ tốt hơn hẳn ở ít nhất một mục tiêu \n  A tốt hơn B ở tất cả các mục tiêu \n  A có chi phí thấp hơn B bất chấp các yếu tố khác \n  A và B có giá trị hàm mục tiêu bằng nhau\n\nTuần 5:\n\nQuestion 1\n1 / 1 pts\nMột công ty logistics dùng mô hình giải tích để chọn số kho. Tại số kho tối ưu N*, tổng chi phí xây dựng kho là 50 tỷ đồng/năm. Theo mô hình, tổng chi phí (xây dựng + vận chuyển) tại N* xấp xỉ bao nhiêu?\n\n  150 tỷ \n  100 tỷ \n  75 tỷ \n  200 tỷ \n \nCorrect answer\nQuestion 2\n1 / 1 pts\nSố trạm tối ưu theo mô hình giải tích là 15, nhưng thành phố chỉ đủ đất cho 12 trạm (80% tối ưu). Nhận định nào hợp lý nhất?\n\n  Chi phí chỉ tăng không quá khoảng 10%, vì tổng chi phí rất phẳng quanh điểm tối ưu \n  Chi phí sẽ tăng khoảng 20%, tương ứng với 20% thiếu hụt trạm \n  Phương án không khả thi, bắt buộc phải tìm thêm đất \n  Chi phí sẽ giảm vì ít trạm hơn \n \nCorrect answer\nQuestion 3\n1 / 1 pts\nMột chuỗi bán lẻ tính số cửa hàng cho cả Việt Nam bằng cách giả định nhu cầu trải đều trên toàn quốc, thay vì tính riêng từng vùng. Rủi ro chính là gì?\n\n  Thừa cơ sở ở những vùng thưa dân và ước tính chi phí sai lệch \n  Thiếu cửa hàng ở mọi vùng \n  Không có rủi ro vì mô hình giải tích luôn chính xác \n  Chỉ sai ở các thành phố lớn, vùng thưa dân luôn đúng \n \nCorrect answer\nQuestion 4\n1 / 1 pts\nDùng thuật toán Weiszfeld để tìm vị trí kho cho các cửa hàng ở Hà Nội, kết quả rơi vào giữa Hồ Tây. Cách xử lý phù hợp nhất là gì?\n\n  Chuyển sang mô hình rời rạc với danh sách các vị trí ứng viên khả thi \n  Chạy thêm vài chục vòng lặp để thuật toán tự dời điểm ra bờ \n  Tăng trọng số của cửa hàng gần nhất \n  Chấp nhận kết quả vì đó là điểm tối ưu toán học \n \nCorrect answer\nQuestion 5\n1 / 1 pts\nNăm làng nằm trên một con đường thẳng theo thứ tự P–Q–R–S–T với nhu cầu lần lượt 10, 15, 5, 30, 40 (tổng 100). Áp dụng thuật toán “gấp lá” của Goldman, nên đặt 1 trạm y tế ở đâu?\n\n  S \n  T (nhu cầu lớn nhất) \n  R (nằm chính giữa) \n  Q \n \nCorrect answer\nQuestion 6\n1 / 1 pts\nTrên mạng 7 khu A–G của bài giảng, với ngưỡng 8 phút, cặp trạm nào sau đây KHÔNG phủ được tất cả các khu?\n\n  {C, G} \n  {D, E} \n  C, E} \n  {A, E} \n \nCorrect answer\nQuestion 7\n1 / 1 pts\nVẫn mạng 7 khu (tổng 870 cuộc gọi/năm), ngưỡng phủ 5 phút. Nếu chỉ đặt 1 trạm tại C, trạm này phủ được bao nhiêu cuộc gọi?\n\n  300 \n  120 \n  345 \n  450 \n \nCorrect answer\nQuestion 8\n1 / 1 pts\nGiải bài toán p-tâm bằng tìm kiếm nhị phân với mô hình phủ tối đa. Khoảng hiện tại là [Thấp \u003d 5, Cao \u003d 8]. Thử ngưỡng 6 phút thì phủ được hết. Bước tiếp theo là gì?\n\n  Khoảng mới [5, 6] \n  Khoảng mới [6, 8] \n  Dừng, đáp án là 6 \n  Khoảng mới [0, 6] \n \nCorrect answer\nQuestion 9\n1 / 1 pts\nHai thôn có dân số bằng nhau, cách nhau 10 km trên một con đường. Cần đặt 1 trạm cứu hộ để khoảng cách xa nhất là nhỏ nhất, và được phép đặt ở bất kỳ điểm nào trên đường. Khoảng cách xa nhất tối ưu là bao nhiêu?\n\n  5 km \n  10 km \n  0 km \n  7,5 km \n \nCorrect answer\nQuestion 10\n1 / 1 pts\nMột quận đang có 1 trạm cứu thương ở vị trí tối ưu theo p-trung vị. Nay có ngân sách cho trạm thứ hai, trưởng phòng đề xuất giữ nguyên trạm cũ và chỉ chọn thêm 1 vị trí tốt nhất. Nhận định nào đúng?\n\n  Có thể kém tối ưu đáng kể, vì cặp trạm tối ưu có thể không chứa trạm cũ \n  Luôn cho nghiệm tối ưu vì trạm cũ đã tối ưu \n  Chỉ kém tối ưu khi dùng mô hình phủ, không xảy ra với p-trung vị \n  Luôn kém đúng 26% \n \nCorrect answer\nQuestion 11\n1 / 1 pts\nTrong bài toán phí cố định, giá xăng tăng mạnh khiến chi phí vận chuyển mỗi cuộc gọi trên mỗi phút (α) tăng. Mô hình sẽ có xu hướng đề xuất gì?\n\n  Mở nhiều trạm hơn, kể cả trạm có chi phí mở cao \n  Đóng bớt trạm để tiết kiệm \n  Giữ nguyên số trạm \n  Chỉ mở trạm rẻ nhất là G \n \nCorrect answer\nQuestion 12\n1 / 1 pts\nHội đồng thành phố được đánh giá theo tiêu chí “% cuộc gọi được phục vụ trong 5 phút”. Với 3 trạm trên mạng A–G, họ nên chọn phương án nào?\n\n  B, C, G (phủ 825/870 trong 5 phút) \n  B, C, E (trung bình 1,615 phút) \n  A, D, F \n  ai phương án như nhau vì cùng 3 trạm \n \nCorrect answer\nQuestion 13\n1 / 1 pts\n"},{"ty":"as","st":"paragraph","si":8159,"ei":8159,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_ifl_i":true,"ps_bb_i":true,"ps_pbb_i":true}},{"ty":"as","st":"paragraph","si":8232,"ei":8232,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":true,"ps_sd_i":true,"ps_sb_i":true,"ps_sa_i":true,"ps_lslm_i":true,"ps_br_i":true,"ps_bbtw_i":true,"ps_kwn_i":true,"ps_bt_i":true,"ps_ifl_i":true,"ps_bb_i":true,"ps_pbb_i":true}},{"ty":"as","st":"paragraph","si":8269,"ei":8269,"sm":{"ps_klt_i":true,"ps_awao_i":true,"ps_sm_i":true,"ps_ls_i":true,"ps_il_i":true,"ps_ir_i":true,"ps_al_i":true,"ps_bl_i":t