{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contact-center:scheduling-request:1.0.0",
  "title": "SchedulingRequest v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "timezone", "horizon", "skills", "slots", "demand", "employees", "shift_templates", "rules", "objective", "solver_options"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/id"},
    "timezone": {"type": "string", "minLength": 1},
    "horizon": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "slot_minutes"],
      "properties": {"start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}, "slot_minutes": {"const": 30}}
    },
    "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}},
    "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}},
    "demand": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/demand"}},
    "employees": {"type": "array", "items": {"$ref": "#/$defs/employee"}},
    "shift_templates": {"type": "array", "items": {"$ref": "#/$defs/template"}},
    "rules": {
      "type": "object", "additionalProperties": false,
      "required": ["shift_span_minutes", "break_minutes", "min_rest_minutes", "max_consecutive_workdays", "max_shifts_per_local_day", "allow_unassigned"],
      "properties": {
        "shift_span_minutes": {"const": 480, "description": "Productive minutes excluding the planned break. For the standard 8-hour work shift, elapsed start-to-end span is 540 minutes."}, "break_minutes": {"const": 60},
        "min_rest_minutes": {"const": 720}, "max_consecutive_workdays": {"const": 5},
        "max_shifts_per_local_day": {"const": 1}, "allow_unassigned": {"const": true}
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "shortage_weight", "overstaff_weight", "assignment_weight", "preference_weight", "fairness_weight"],
      "properties": {
        "mode": {"const": "weighted_sum"},
        "shortage_weight": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "overstaff_weight": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "assignment_weight": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "preference_weight": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "fairness_weight": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "solver_options": {
      "type": "object", "additionalProperties": false,
      "required": ["time_limit_seconds", "num_search_workers", "random_seed", "return_baseline_on_timeout"],
      "properties": {
        "time_limit_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "num_search_workers": {"type": "integer", "minimum": 1, "maximum": 8},
        "random_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "return_baseline_on_timeout": {"const": true}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "date": {"type": "string", "format": "date"},
    "interval": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}}
    },
    "skill": {
      "type": "object", "additionalProperties": false, "required": ["skill_id", "label"],
      "properties": {"skill_id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}}
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["slot_id", "start", "end"],
      "properties": {"slot_id": {"$ref": "#/$defs/id"}, "start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}}
    },
    "demand": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "skill_id", "required_agents", "priority", "forecast", "erlang"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"}, "skill_id": {"$ref": "#/$defs/id"},
        "required_agents": {"type": "integer", "minimum": 0, "maximum": 10000},
        "priority": {"type": "integer", "minimum": 1, "maximum": 100},
        "forecast": {
          "type": "object", "additionalProperties": false,
          "required": ["expected_calls", "aht_seconds", "method", "quantile"],
          "properties": {
            "expected_calls": {"type": "number", "minimum": 0},
            "aht_seconds": {"type": "number", "exclusiveMinimum": 0},
            "method": {"type": "string", "minLength": 1},
            "quantile": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          }
        },
        "erlang": {
          "type": "object", "additionalProperties": false,
          "required": ["service_level", "answer_within_seconds", "max_occupancy", "shrinkage_excluding_planned_breaks", "offered_load_erlangs", "net_agents"],
          "properties": {
            "service_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "answer_within_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_occupancy": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "shrinkage_excluding_planned_breaks": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
            "offered_load_erlangs": {"type": "number", "minimum": 0},
            "net_agents": {"type": "integer", "minimum": 0, "maximum": 10000}
          }
        }
      }
    },
    "employee": {
      "type": "object", "additionalProperties": false,
      "required": ["employee_id", "label", "skill_ids", "availability", "max_scheduled_minutes_in_horizon", "history", "preferences"],
      "properties": {
        "employee_id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
        "skill_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "availability": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
        "max_scheduled_minutes_in_horizon": {"type": "integer", "minimum": 0, "multipleOf": 480},
        "history": {
          "type": "object", "additionalProperties": false,
          "required": ["last_shift_end", "previous_local_days"],
          "properties": {
            "last_shift_end": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
            "previous_local_days": {"type": "array", "minItems": 6, "maxItems": 6, "items": {
              "type": "object", "additionalProperties": false, "required": ["date", "worked"],
              "properties": {"date": {"$ref": "#/$defs/date"}, "worked": {"type": "boolean"}}
            }}
          }
        },
        "preferences": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["template_id", "penalty"],
          "properties": {"template_id": {"$ref": "#/$defs/id"}, "penalty": {"type": "integer", "minimum": 0, "maximum": 100}}
        }}
      }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "start", "end", "breaks", "allowed_skill_ids"],
      "properties": {
        "template_id": {"$ref": "#/$defs/id"}, "start": {"$ref": "#/$defs/timestamp", "description": "Shift instance start; user-facing templates are converted by the adapter."}, "end": {"$ref": "#/$defs/timestamp", "description": "Shift instance end; standard 8 productive hours plus 1-hour break spans 540 elapsed minutes."},
        "breaks": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/interval"}},
        "allowed_skill_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
